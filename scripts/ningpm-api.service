[Unit]
Description=ningpm API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/ningpm/apps/api
EnvironmentFile=-/www/wwwroot/ningpm/.env
ExecStart=/www/wwwroot/ningpm/apps/api/bin/api
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
