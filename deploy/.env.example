NINGPM_VERSION=0.25.0
NINGPM_HTTP_ADDR=127.0.0.1:8091
NINGPM_ENV=production
NINGPM_JWT_SECRET=change-me-to-a-long-random-string

# 生产：MySQL（Docker ningpm-mysql → 127.0.0.1:3308）
NINGPM_DB_DRIVER=mysql
NINGPM_DB_DSN=ningpm:change-me@tcp(127.0.0.1:3308)/ningpm?parseTime=true&charset=utf8mb4&loc=UTC
NINGPM_FILES_DIR=/www/wwwroot/ningpm/data/files

# Docker MySQL 初始化
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
